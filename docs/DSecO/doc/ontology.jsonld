}, {
  "@id" : "https://w3id.org/dseco/ontology/",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@value" : "Lionel Tailhardat (https://orcid.org/0000-0001-5887-899X)"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Didier Bringer (https://orcid.org/0009-0007-9787-2559)"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "The DNS Security Ontology (DSecO) project is a data model for representing and reasoning on Domain Name System (DNS) data.\nThe ontology is developed using web technologies (e.g. RDF, OWL, SKOS) and is intended as a structure for realizing a DNS Knowledge Graph (KG) for administration and security assessment applications. The model has been developed in collaboration with operational teams, and in connection with third parties linked vocabularies.\n\nAlignment with third parties vocabularies is implemented on a per class or per property basis when relevant (e.g. with `rdfs:subClassOf`, `owl:equivalentClass`).\nDirections for direct instanciation of these vocabularies are provided for cases where implementing a class/property alignment is redundant.\nAlignment holds for the following vocabulary releases:\n\n- [ORG](https://www.w3.org/TR/vocab-org/) 0.8\n- [UCO](https://github.com/ucoProject/uco) Release-0.8.0\n"
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2022-05-10"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://spdx.org/licenses/BSD-4-Clause"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-06-03"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@id" : "https://www.orange.com/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "The DNS Security Ontology"
  } ],
  "http://purl.org/ontology/bibo/status" : [ {
    "@id" : "http://purl.org/ontology/bibo/status/draft"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "dseco"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/dseco/ontology/"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://purl.org/vocommons/voaf#Vocabulary"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://w3id.org/dseco/doc/"
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@id" : "file:/home/rgky0185/IdeaProjects/public/dseco/ontology/dseco-1.8.3"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "file:/home/rgky0185/IdeaProjects/public/dseco/ontology/dseco-2.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "v2.0.0"
  } ],
  "http://www.w3.org/2004/02/skos/core#changeNote" : [ {
    "@language" : "en",
    "@value" : "Changes in v2.0.0:\n\n- Used only camelCase for properties : list of properties and their changes:\n    - is_CNAME_of -> isCNAMEOf\n    - is_A_to -> isATo\n    - is_AAAA_to -> isAAAATo\n    - resolves_to -> resolvesTo\n    - is_in_zone -> isInZONE\n    - is_CNAME_of_CNAME_of -> isCNAMEOfCNAMEOf\n    - is_part_of -> isPartOf\n    - is_hosted_by -> isHostedBy\n    - is_included_in -> isIncludedIn\n    - isinOurSubnet -> isInOurSubnet\n    - FQDN_ends_in_exampleorg -> FQDNEndsInExampleorg\n    - answers_on_port_443 -> answersOnPort443\n    - answers_on_port_80 -> answersOnPort80\n    - answers_on_port -> answersOnPort)\n- Deleted TAG and hasTag and replaced it by knownFrom and ORGU_team_GCP\n"
  } ]
}, {
  "@id" : "https://w3id.org/dseco/ontology/COMPONENT",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A COMPONENT is able of hosting a FQDN, a COMPONENT is made of other COMPONENTs."
  }, {
    "@language" : "fr",
    "@value" : "Un COMPONENT peut héberger un FQDN et est constitué d’autres COMPONENTs."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/dseco/ontology/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "COMPONENT"
  } ],
  "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status" : [ {
    "@value" : "stable"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "# Example of a COMPONENT instance\n:COMPONENT_1212 a :COMPONENT .\nbased on sbom.json\n"
  } ]
