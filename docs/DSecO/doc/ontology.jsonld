  "@id" : "https://w3id.org/dseco/ontology/FQDN",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Fully Qualified Domain Name."
  }, {
    "@language" : "fr",
    "@value" : "Un fully qualified domain name (FQDN, ou nom de domaine pleinement qualifié) est un nom de domaine qui donne la position exacte de son noeud dans l'arborescence DNS en indiquant tous les domaines de niveau supérieur."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/dseco/ontology/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "FQDN"
  } ],
  "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status" : [ {
    "@value" : "stable"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "# Example of a FQDN instance\n:FQDN_example.com a :FQDN .\n"
  } ]
}, {
  "@id" : "https://w3id.org/dseco/ontology/FQDNEndsInExampleorg",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Cette propriété est définie ici à des fins d’illustration. Elle est renseignée à l’aide d’une requête INSERT ... WHERE."
  }, {
    "@language" : "en",
    "@value" : "This property is designed here for illustrative purposes. It is populated by an INSERT WHERE."
  } ],
