}, {
  "@id" : "https://w3id.org/dseco/ontology/",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@value" : "Antoine Cawet"
  }, {
    "@value" : "Lionel Tailhardat (https://orcid.org/0000-0001-5887-899X)"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Didier Bringer (https://orcid.org/0009-0007-9787-2559)"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "The DNS Security Ontology (DSecO) project is a data model for representing and reasoning on Domain Name System (DNS) data.\nThe ontology is developed using web technologies (e.g. RDF, OWL, SKOS) and is intended as a structure for realizing a DNS Knowledge Graph (KG) for administration and security assessment applications. The model has been developed in collaboration with operational teams, and in connection with third parties linked vocabularies.\n\nAlignment with third parties vocabularies is implemented on a per class or per property basis when relevant (e.g. with `rdfs:subClassOf`, `owl:equivalentClass`).\nDirections for direct instanciation of these vocabularies are provided for cases where implementing a class/property alignment is redundant.\nAlignment holds for the following vocabulary releases:\n\n- [ORG](https://www.w3.org/TR/vocab-org/) 0.8\n- [UCO](https://github.com/ucoProject/uco) 1.4.0\n"
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2022-05-10"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://spdx.org/licenses/BSD-4-Clause"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-06-14"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@id" : "https://www.orange.com/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "The DNS Security Ontology"
  } ],
  "http://purl.org/ontology/bibo/status" : [ {
    "@id" : "http://purl.org/ontology/bibo/status/peerReviewed"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "dseco"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/dseco/ontology/"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://purl.org/vocommons/voaf#Vocabulary"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://w3id.org/dseco/doc/"
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@id" : "file:/home/rgky0185/IdeaProjects/public/dseco/ontology/dseco-1.5.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "file:/home/rgky0185/IdeaProjects/public/dseco/ontology/dseco-1.6.1"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "v1.6.1"
  } ],
  "http://www.w3.org/2004/02/skos/core#changeNote" : [ {
    "@language" : "en",
    "@value" : "Changes in v1.6.1:\n\n- Added rename dseco:whoisdomain in dseco:ZONE\n- Added observable:IPAddress observable:IPAddressFacet\n- Added observable:IPv4Address observable:IPv6Address\n- Added observable:NetworkSubnet , observable:IPAddress dseco:is_part_of observable:NetworkSubnet\n- Added observable:AutonomousSystem core:hasFacet observable:AutonomousSystemFacet\n- Added observable:IPAddress :hasAS observable:AutonomousSystem\n- Added observable:NetworkSubnet dseco:hasAS observable:AutonomousSystem\n\n"
  } ]
