  } ]
}, {
  "@id" : "https://w3id.org/dseco/ontology/SERVICEID",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A SERVICEID is an identifier of a service, it is associated to a FQDN and can be used to link security indicators."
  }, {
    "@language" : "fr",
    "@value" : "Un SERVICEID est un identifiant de service associé à un FQDN et pouvant servir à relier des indicateurs de sécurité."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/dseco/ontology/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "SERVICEID"
  } ],
  "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status" : [ {
    "@value" : "stable"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "# Example of a SERVICEID instance\n:SERVICEID_1 a :SERVICEID .\n"
  } ]
}, {
