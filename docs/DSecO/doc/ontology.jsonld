    "@language" : "en",
    "@value" : "\n# Example of using hasAS property\n<:SUBNET_12.12.12.0/24> a observable:NetworkSubnet ;\n    :hasAS :AS_64496 .\n"
  } ]
}, {
  "@id" : "https://w3id.org/dseco/ontology/hasCountry",
