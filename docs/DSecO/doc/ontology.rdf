    <!-- https://w3id.org/dseco/ontology/hasAS -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/hasAS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/IPAddress"/>
                    <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/NetworkSubnet"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/hasOrgu -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/hasOrgu">
        <rdfs:domain rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/AutonomousSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/org#OrganizationalUnit"/>
        <rdfs:comment xml:lang="en">An AS belongs to an organizational Unit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>hasOrgu</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using hasOrgu property
:AS_64496 a observable:AutonomousSystem ;
    :hasOrgu :ORGU_network_provider .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/is_AAAA_to -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/is_AAAA_to">
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:range rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/IPv6Address"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>is_AAAA_to</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using is_AAAA_to property
:FQDN_example.com a :FQDN ;
    :is_AAAA_to :IP_::1 .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/is_A_to -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/is_A_to">
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:range rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/IPv4Address"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>is_A_to</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using is_A_to property
:FQDN_example.com a :FQDN ;
    :is_A_to :IP_192.0.2.1 .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/is_CNAME_of -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/is_CNAME_of">
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:range rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>is_CNAME_of</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using is_CNAME_of property
:FQDN_alias.example.com a :FQDN ;
    :is_CNAME_of :FQDN_target.example.com .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/is_CNAME_of_CNAME_of -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/is_CNAME_of_CNAME_of">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/dseco/ontology/is_CNAME_of"/>
            <rdf:Description rdf:about="https://w3id.org/dseco/ontology/is_CNAME_of"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="en">To test inferences.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>is_CNAME_of_CNAME_of</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using is_CNAME_of_CNAME_of property
:FQDN_example.com a :FQDN ;
    :is_CNAME_of_CNAME_of :FQDN_example2.com .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/is_in_zone -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/is_in_zone">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:range rdf:resource="https://w3id.org/dseco/ontology/ZONE"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>is_in_zone</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using is_in_zone property
:FQDN_example.com a :FQDN ;
    :is_in_zone :ZONE_example.com .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/is_part_of -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/is_part_of">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/IPAddress"/>
        <rdfs:range rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/NetworkSubnet"/>
        <rdfs:comment xml:lang="en">A network subnet associated to an IP address.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Un subnet associé à une adresse IP.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>is_part_of</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using is_part_of property
:IP_12.12.12.1 a observable:IPAddress ;
    :is_part_of &lt;:SUBNET_12.12.12.0/24&gt; .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/managedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/managedBy">
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/ZONE"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/org#OrganizationalUnit"/>
        <rdfs:comment xml:lang="en">The Agent or Owner that can change entries in the zone.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>managedBy</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using managedBy property
:ZONE_example.com a :ZONE ;
    :managedBy :ORGU_internal .
</skos:example>
    </owl:ObjectProperty>
    


