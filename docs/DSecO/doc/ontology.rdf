    <!-- https://w3id.org/dseco/ontology/FQDNEndsInExampleorg -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dseco/ontology/FQDNEndsInExampleorg">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="fr">Cette propriété est définie ici à des fins d’illustration. Elle est renseignée à l’aide d’une requête INSERT ... WHERE.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property is designed here for illustrative purposes. It is populated by an INSERT WHERE.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>FQDNEndsInExampleorg</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using FQDNEndsInExampleorg property
:FQDN_www.example.org a :FQDN ;
    :FQDNEndsInExampleorg &quot;true&quot;^^xsd:boolean .
</skos:example>
    </owl:DatatypeProperty>
    


