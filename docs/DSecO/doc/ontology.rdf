    <!-- https://w3id.org/dseco/ontology/FQDN -->


    <owl:Class rdf:about="https://w3id.org/dseco/ontology/FQDN">
        <rdfs:comment xml:lang="en">Fully Qualified Domain Name.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>FQDN</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of a FQDN instance
:FQDN_example.com a :FQDN .
</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/dseco/ontology/ZONE -->


    <owl:Class rdf:about="https://w3id.org/dseco/ontology/ZONE">
        <rdfs:comment xml:lang="en">A domain zone in DNS context. A DNS zone is an administrative subdivision of the DNS namespace.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>ZONE</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of a ZONE instance
:ZONE_example.com a :ZONE .
</skos:example>
    </owl:Class>
    


