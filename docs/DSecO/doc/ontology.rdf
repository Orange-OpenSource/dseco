    <!-- https://w3id.org/dseco/ontology/dependsOn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/dependsOn">
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/COMPONENT"/>
        <rdfs:range rdf:resource="https://w3id.org/dseco/ontology/COMPONENT"/>
        <rdfs:comment xml:lang="en">A COMPONENT depends on another COMPONENT.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Un COMPONENT dépend d’un autre COMPONENT.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>dependsOn</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using dependsOn property
:COMPONENT_1212 a :COMPONENT ;
    :dependsOn :COMPONENT_3434 .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/hasAS -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/hasAS">
        <owl:inverseOf rdf:resource="https://w3id.org/dseco/ontology/originates"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/IPAddress"/>
                    <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/NetworkSubnet"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/dseco/ontology/isPartOf"/>
            <rdf:Description rdf:about="https://w3id.org/dseco/ontology/hasAS"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/hasOrgu -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/hasOrgu">
        <rdfs:domain rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/AutonomousSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/org#OrganizationalUnit"/>
        <rdfs:comment xml:lang="en">An AS belongs to an organizational unit.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Un AS appartient à une unité organisationnelle.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>hasOrgu</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using hasOrgu property
:AS_64496 a observable:AutonomousSystem ;
    :hasOrgu :ORGU_network_provider .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/hasServiceId -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/hasServiceId">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/dseco/ontology/COMPONENT"/>
                    <rdf:Description rdf:about="https://w3id.org/dseco/ontology/FQDN"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/dseco/ontology/SERVICEID"/>
        <rdfs:comment xml:lang="fr">L&apos;identifiant de service associé au FQDN.</rdfs:comment>
        <rdfs:comment xml:lang="en">The service ID associated with the FQDN.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>hasServiceId</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using hasServiceId property
:FQDN_www.example.org a :FQDN ;
    :hasServiceId :SERVICEID_123 .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/isAAAATo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/isAAAATo">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/dseco/ontology/resolvesTo"/>
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:range rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/IPv6Address"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>isAAAATo</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using isAAAATo property
:FQDN_example.com a :FQDN ;
    :isAAAATo :IP_::1 .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/isATo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/isATo">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/dseco/ontology/resolvesTo"/>
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:range rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/IPv4Address"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>isATo</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using isATo property
:FQDN_example.com a :FQDN ;
    :isATo :IP_192.0.2.1 .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/isCNAMEOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/isCNAMEOf">
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:range rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>isCNAMEOf</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using isCNAMEOf property
:FQDN_alias.example.com a :FQDN ;
    :isCNAMEOf :FQDN_target.example.com .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/isCNAMEOfCNAMEOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/isCNAMEOfCNAMEOf">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/dseco/ontology/isCNAMEOf"/>
            <rdf:Description rdf:about="https://w3id.org/dseco/ontology/isCNAMEOf"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="fr">Pour tester les inférences.</rdfs:comment>
        <rdfs:comment xml:lang="en">To test inferences.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>isCNAMEOfCNAMEOf</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using isCNAMEOfCNAMEOf property
:FQDN_example.com a :FQDN ;
    :isCNAMEOfCNAMEOf :FQDN_example2.com .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/isHostedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/isHostedBy">
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:range rdf:resource="https://w3id.org/dseco/ontology/COMPONENT"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>isHostedBy</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using isHostedBy property
:FQDN_alias.example.com a :FQDN ;
    :isHostedBy :COMPONENT_1212 .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/isInZONE -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/isInZONE">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:range rdf:resource="https://w3id.org/dseco/ontology/ZONE"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>isInZONE</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using isInZONE property
:FQDN_example.com a :FQDN ;
    :isInZONE :ZONE_example.com .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/isIncludedIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/isIncludedIn">
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/COMPONENT"/>
        <rdfs:range rdf:resource="https://w3id.org/dseco/ontology/COMPONENT"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>isIncludedIn</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using isIncludedIn property
:COMPONENT_1212 a :COMPONENT ;
    :isIncludedIn :COMPONENT_3434 .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/isPartOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/isPartOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/IPAddress"/>
        <rdfs:range rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/NetworkSubnet"/>
        <rdfs:comment xml:lang="en">A network subnet associated to an ip address.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Un subnet associé à une adresse ip.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>isPartOf</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using isPartOf property
:IP_12.12.12.1 a observable:IPAddress ;
    :isPartOf &lt;:SUBNET_12.12.12.0/24&gt; .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/knownFrom -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/knownFrom">
        <rdfs:range rdf:resource="http://www.w3.org/ns/org#OrganizationalUnit"/>
        <rdfs:comment xml:lang="en">An entity is known from an organizational unit.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une entité est connue d’une unité organisationnelle.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>knownFrom</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using knownFrom property
:IP_12.12.12.1 a observable:IPAddress ;
    :knownFrom :OrganizationalUnit_1 .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/managedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/managedBy">
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/ZONE"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/org#OrganizationalUnit"/>
        <rdfs:comment xml:lang="fr">L’agent (Agent) ou le propriétaire (Owner) autorisé à modifier les entrées de la zone.</rdfs:comment>
        <rdfs:comment xml:lang="en">The Agent or Owner that can change entries in the zone.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>managedBy</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using managedBy property
:ZONE_example.com a :ZONE ;
    :managedBy :ORGU_internal .
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/originates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/originates">
        <rdfs:domain rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/AutonomousSystem"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/IPAddress"/>
                    <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/NetworkSubnet"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">A network entity associated with an Autonomous System.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une entité associée à un système autonome (AS).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>originates</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en"># Example of using originates property
:AS_64496 a observable:AutonomousSystem ;
    :originates  &lt;:SUBNET_12.12.12.0/24&gt;.
</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dseco/ontology/resolvesTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dseco/ontology/resolvesTo">
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
    </owl:ObjectProperty>
    


