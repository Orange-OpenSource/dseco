    <!-- https://w3id.org/dseco/ontology/FQDN_ends_in_exampleorg -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dseco/ontology/FQDN_ends_in_exampleorg">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/dseco/ontology/FQDN"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">This property is designed here for illustrative purposes. It is populated by an INSERT WHERE.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>FQDN_ends_in_exampleorg</rdfs:label>
        <ns:term_status>unstable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using FQDN_ends_in_exampleorg property
:FQDN_www.example.org a :FQDN ;
    :FQDN_ends_in_exampleorg &quot;true&quot;^^xsd:boolean .
</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/dseco/ontology/hasAS -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dseco/ontology/hasAS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/AutonomousSystem"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/dseco/ontology/hasCountry -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dseco/ontology/hasCountry">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/IPAddress"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Le pays où se trouve l&apos;entité.</rdfs:comment>
        <rdfs:comment xml:lang="en">The country where the entity is located.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>hasCountry</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using hasCountry property
:IP_203.0.113.1 a observable:IPAddress ;
    :hasCountry &quot;FR&quot;^^xsd:string .
</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/dseco/ontology/hasName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dseco/ontology/hasName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/dseco/ontology/FQDN"/>
                    <rdf:Description rdf:about="https://w3id.org/dseco/ontology/ZONE"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Le domaine de :hasName est spécifié comme une classe anonyme (indiquée par les crochets []) qui est de type owl:Class et qui a une liste owl:unionOf contenant :A et :B.
Cela signifie que :hasName peut être utilisée avec des instances de la classe A ou de la classe B.</rdfs:comment>
        <rdfs:comment xml:lang="en">The domain of :hasName is specified as an anonymous class (indicated by the brackets []) that is of type owl:Class and has an owl:unionOf list containing :A and :B.
This means that :hasName can be used with instances of class A or class B.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>hasName</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using hasName property
:FQDN_example.com a :FQDN ;
    :hasName &quot;example.com.&quot;^^xsd:string .

# Can also be used with ZONE
:ZONE_example.org a :ZONE ;
    :hasName &quot;example.org.&quot;^^xsd:string .
</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/dseco/ontology/isinOurSubnet -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dseco/ontology/isinOurSubnet">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/IPAddress"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True if the IP is in our subnets. It is populated by a INSERT WHERE query.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/dseco/ontology/"/>
        <rdfs:label>isinOurSubnet</rdfs:label>
        <ns:term_status>unstable</ns:term_status>
        <skos:example xml:lang="en">
# Example of using isinOurSubnet property
:IP_198.51.100.1 a observable:IPAddress ;
    :isinOurSubnet &quot;true&quot;^^xsd:boolean .
</skos:example>
    </owl:DatatypeProperty>
    


