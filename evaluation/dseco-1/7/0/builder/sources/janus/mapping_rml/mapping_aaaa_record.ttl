@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix mykg: <https://w3id.org/dseco/mykg/> .
@prefix dseco: <https://w3id.org/dseco/ontology/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno: 	<https://w3id.org/function/ontology#> .
@prefix grel: 	<http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix idlab-fn: <http://example.com/idlab/function/> .


#### Mapping des AAAA RECORD
mykg:MappingAAAA a rml:LogicalSource ;
    rml:source "${TMPDIR}/janus.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[?(@.recordtype == 'AAAA RECORD' )]" .  


mykg:TriplesMapAAAA a rr:TriplesMap ;
    rml:logicalSource mykg:MappingAAAA ;  
    rr:subjectMap [
        rr:template "https://w3id.org/dseco/mykg/FQDN_{recordsource}" ;
        rr:class dseco:FQDN ;
        rr:class owl:NamedIndividual ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dseco:hasName ;
        rr:objectMap [ rml:reference "recordsource" ; rr:datatype xsd:string ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dseco:hasOwner ;
        rr:objectMap [ rml:reference "owner" ; rr:datatype xsd:string] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dseco:hasServiceId ;
        rr:objectMap [ rml:reference "${serviceid}" ; rr:datatype xsd:string] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dseco:is_in_zone ;
        rr:objectMap [ rr:template "https://w3id.org/dseco/mykg/ZONE_{domain}." ] ;
    ] ;


    rr:predicateObjectMap [
        rr:predicate dseco:is_AAAA_to ;
        rr:objectMap [
            rr:parentTriplesMap mykg:TriplesMapIPv6 ;
            rr:joinCondition [
                rr:child "recordtarget";
                rr:parent "recordtarget";
            ];
        ] ;
    ] .


mykg:TriplesMapIPv6 a rr:TriplesMap ;
    rml:logicalSource mykg:MappingAAAA ;

    rr:subjectMap [
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant idlab-fn:concat ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate idlab-fn:str ;
                rr:objectMap [ rr:constant "https://w3id.org/dseco/mykg/IP_" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate idlab-fn:otherStr ;
                rr:objectMap [ rml:reference "recordtarget" ]
            ]
        ] ;
        rr:class observable:IPAddress ;
        rr:class observable:IPv6Address ;
        rr:class owl:NamedIndividual ;
    ] .
