@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix mykg: <https://w3id.org/dseco/mykg/> .
@prefix dseco: <https://w3id.org/dseco/ontology/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@prefix core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

### Mapping des ASN
mykg:MappingASN a rml:LogicalSource ;
    rml:source "${TMPDIR}/janus.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[?(@.recordtype == 'AAAA RECORD' || @.recordtype == 'A RECORD')]" .  


mykg:TriplesMapASN a rr:TriplesMap ;
    rml:logicalSource mykg:MappingASN ; 
    rr:subjectMap [
        rr:template "https://w3id.org/dseco/mykg/AS_{asn}" ;
        rr:class observable:AutonomousSystem ;
        rr:class owl:NamedIndividual ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate core:hasFacet ;
        rr:objectMap [
            rr:parentTriplesMap mykg:TriplesMapASNFacet ;
            rr:joinCondition [
                rr:child "asn";
                rr:parent "asn";
            ];
        ] ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate dseco:hasOrgu ;
        rr:objectMap [
            rr:template "https://w3id.org/dseco/mykg/ORGU_{asnorgu}" ;
        ] ;
    ] .

# Création d'un nouveau TriplesMap pour le facet ASN
mykg:TriplesMapASNFacet a rr:TriplesMap ;
    rml:logicalSource mykg:MappingASN ;
    rr:subjectMap [
        rr:template "ASNFacet_{asn}";
        rr:termType rr:BlankNode ;
        rr:class observable:AutonomousSystemFacet ;
    ] ;
    
    rr:predicateObjectMap [
        rr:predicate observable:asHandle ;
        rr:objectMap [
             rml:reference "asn" ;
        ] ;
    ] .


