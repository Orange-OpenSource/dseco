# Gherkin metadata (fr)
#
# Étant donné un graphe de connaissances DNS peuplé d'entités de données DNS
# Lorsque un fqdn de la zone example.org existe et resoud au final sur une adresse IP hors de nos subnet
# Alors il est a surveiller de prés.


# Gherkin metadata (en)
#
# Given a dns-kg populated with dns data entities 
# When a fqdn exist in the example.org zone and resolve in the end to an IP address outside of our subnet 
# Then it should be monitored closely

# GRLC metadata
#+ summary: 
#+ method: GET
#+ tags:
#+   - DNS-KG | Security Audit Rule

PREFIX dseco: <https://w3id.org/dseco/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX mykg: <https://w3id.org/dseco/mykg/>

SELECT ?nameOrig ?orgu
WHERE {
      ?Fqdn_orig dseco:is_CNAME_of+ ?Fqdn_end .
      FILTER NOT EXISTS {
		?Fqdn_end dseco:is_CNAME_of ?_OtherFQDN
      }

      ?Fqdn_orig dseco:hasName ?nameOrig .
      ?Fqdn_orig dseco:is_in_zone ?Zorig .
      ?Zorig dseco:hasName "example.org."^^xsd:string .

      ?Fqdn_end dseco:hasName ?nameEnd .
      ?Fqdn_end dseco:is_A_to ?IP_End .
      
      # The interesting part of the query
      FILTER NOT EXISTS {
          ?IP_End dseco:isinOurSubnet "true"^^xsd:boolean .
      }
      
      ?IP_End dseco:is_part_of ?SUBNET .
      ?SUBNET dseco:hasAS ?AS .
      ?AS dseco:hasOrgu ?orgu .

      FILTER(?orgu NOT IN (mykg:ORGU_friendly)) .
      

}
# to ensure that the order is maintained, this way testing the ontology or the inferred ontology will do the same.
ORDER BY ?nameOrig ?orgu
