# Gherkin metadata (fr)
#
# Étant donné un graphe de connaissances DNS peuplé d'entités de données DNS
# Lorsque un fqdn de la zone example.org existe et resoud au final sur une adresse IP hors de nos subnet
# Alors il est a surveiller de prés.


# Gherkin metadata (en)
#
# Given a dns-mykg populated with dns data entities
# When a fqdn exist in the example.org zone and resolve in the end to an IP address which has the google's asn (396982)
# Then it should be monitored closely

# GRLC metadata
#+ summary:
#+ method: GET
#+ tags:
#+   - DNS-KG | Security Audit Rule

PREFIX dseco: <https://w3id.org/dseco/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX mykg: <https://w3id.org/dseco/mykg/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> 
PREFIX core: <https://ontology.unifiedcyberontology.org/uco/core/> 

SELECT DISTINCT ?nameOrig ?IP_End
WHERE
{
      ?Fqdn_orig dseco:isCNAMEOf* ?Fqdn_end .
      ?Fqdn_end dseco:resolvesTo ?IP_End .

      ?Fqdn_orig dseco:hasName ?nameOrig .
      ?Fqdn_orig a mykg:FQDN_exampleorg_resolving .
      
      ?IP_End dseco:hasAS ?AS .
      FILTER (?AS = mykg:AS_AS396982 || ?AS = mykg:AS_AS15169) .
      # FILTER EXISTS{
      #   ?AS dseco:hasOrgu mykg:ORGU_google .
      # }

}

# ORDER is mandatory to ensure that the test is deterministic
ORDER BY ?nameOrig ?IP_End
