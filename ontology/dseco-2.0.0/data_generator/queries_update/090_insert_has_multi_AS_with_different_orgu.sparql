# Add class in the KG not in the ontology, the need is a local one
# useless for the onto, usefull for the mykg

PREFIX dseco: <https://w3id.org/dseco/ontology/> 
PREFIX mykg: <https://w3id.org/dseco/mykg/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

INSERT { ?Fqdn_orig mykg:has_multi_AS_with_different_orgu true . }
WHERE {
    # We cannot use the previous knowledge has_multi_AS because otherwise the query will killed the process
    # Because we test too many combination of ASes and orgus
    ?Fqdn_orig dseco:isCNAMEOf* ?Fqdn_end .

    ?Fqdn_end dseco:resolvesTo ?IP1, ?IP2 .

    ?IP1 dseco:hasAS ?AS1 .
    ?IP2 dseco:hasAS ?AS2 .

    ?AS1 dseco:hasOrgu ?Org1 .
    ?AS2 dseco:hasOrgu ?Org2 .
    FILTER(?IP1 != ?IP2 && ?Org1 != ?Org2)
}
